# Release lanes (see the maybeitssoftware mobile release runbook). Credentials
# come from the environment: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT
# (base64 .p8), MATCH_PASSWORD, PLAY_SERVICE_ACCOUNT_JSON, and for Android a
# key.properties next to android/app (the shared upload key).

APP_ID = "uk.co.maybeitssoftware.librelog"
TEAM_ID = ENV["TEAM_ID"] || "6NQNU5YSC2"
ROOT = File.expand_path("..", __dir__)

def asc_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"], is_key_content_base64: true,
  )
end

platform :android do
  # Version codes follow the Actions workflow's scheme (android-internal.yml):
  # the UTC date and a two-digit number, e.g. 2026102105, higher than any
  # upload that day. Anything below today's date would sit under codes
  # already on Play.
  desc "Build a signed bundle and put it on the Play internal track as a draft"
  lane :internal do |opts|
    name = opts[:version_name].to_s
    code = opts[:version_code].to_s
    UI.user_error!("version_name: must look like 1.2.3 (got #{name.inspect})") unless name.match?(/\A\d+(\.\d+){0,2}\z/)
    UI.user_error!("version_code: must be a positive integer (got #{code.inspect})") unless code.match?(/\A[1-9]\d{0,9}\z/)
    floor = Time.now.utc.strftime("%Y%m%d00").to_i
    UI.user_error!("version_code: use today's UTC date and a two-digit number, at least #{floor + 1}") if code.to_i <= floor
    UI.user_error!("version_code: Play's limit is 2100000000") if code.to_i > 2_100_000_000
    sh("cd #{ROOT} && scripts/build-android.sh")
    sh("cd #{ROOT}/android && ./gradlew -q bundleRelease -PversionCode=#{code} -PversionName=#{name}")
    upload_to_play_store(
      track: "internal",
      # A draft until rolled out in Play Console; "completed" fails while the
      # Play app itself is still a draft (never published).
      release_status: opts[:release_status] || "draft",
      aab: "#{ROOT}/android/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end
end

platform :ios do
  desc "Fetch (or, with readonly:false, create) the App Store signing profile"
  lane :certificates do |opts|
    match(type: "appstore", app_identifier: APP_ID, api_key: asc_key, readonly: opts[:readonly] != false)
  end

  desc "Archive the iOS app and upload it to TestFlight"
  lane :internal do |opts|
    key = asc_key
    setup_ci if ENV["CI"]
    match(type: "appstore", app_identifier: APP_ID, api_key: key, readonly: opts[:readonly] != false)
    sh("cd #{ROOT} && scripts/build-apple.sh && cd apple && xcodegen -q")
    build_number = opts[:build_number] || (latest_testflight_build_number(api_key: key, app_identifier: APP_ID, initial_build_number: 0) + 1)
    build_app(
      project: "#{ROOT}/apple/Librelog.xcodeproj", scheme: "Librelog",
      destination: "generic/platform=iOS", export_method: "app-store",
      output_directory: "#{ROOT}/apple/build", clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore #{APP_ID}'",
      export_options: { provisioningProfiles: { APP_ID => "match AppStore #{APP_ID}" } },
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true) unless opts[:upload] == false
  end

  # Called by .github/workflows/tramline-ios.yml. Tramline owns the version:
  # it passes both numbers and finds the build in App Store Connect by its
  # build number, so nothing here reads or bumps TestFlight's counter.
  desc "Archive at Tramline's version_name/version_code and upload to TestFlight"
  lane :tramline do |opts|
    name = opts[:version_name].to_s
    code = opts[:version_code].to_s
    UI.user_error!("version_name: must look like 1.2.3 (got #{name.inspect})") unless name.match?(/\A\d+(\.\d+){0,2}\z/)
    UI.user_error!("version_code: must be a positive integer (got #{code.inspect})") unless code.match?(/\A[1-9]\d*\z/)

    key = asc_key
    setup_ci if ENV["CI"]
    # CI and local runs both clone the certs repo over SSH (CI via the
    # MATCH_GIT_SSH_KEY deploy key); MATCH_GIT_URL overrides the Matchfile if set.
    certs = { type: "appstore", app_identifier: APP_ID, api_key: key, readonly: true }
    certs[:git_url] = ENV["MATCH_GIT_URL"] unless ENV["MATCH_GIT_URL"].to_s.empty?
    match(**certs)
    sh("cd #{ROOT} && scripts/build-apple.sh && cd apple && xcodegen -q")
    build_app(
      project: "#{ROOT}/apple/Librelog.xcodeproj", scheme: "Librelog",
      destination: "generic/platform=iOS", export_method: "app-store",
      output_directory: "#{ROOT}/apple/build", clean: true,
      xcargs: "MARKETING_VERSION=#{name} CURRENT_PROJECT_VERSION=#{code} " \
              "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore #{APP_ID}'",
      export_options: { provisioningProfiles: { APP_ID => "match AppStore #{APP_ID}" } },
    )
    upload_to_testflight(api_key: key, app_identifier: APP_ID, skip_waiting_for_build_processing: true)
  end
end
