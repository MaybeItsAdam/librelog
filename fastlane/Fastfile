# Release lanes (see the maybeitssoftware mobile release runbook). Credentials
# come from the environment: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT
# (base64 .p8), MATCH_PASSWORD, PLAY_SERVICE_ACCOUNT_JSON, and for Android a
# key.properties next to android/app (the shared upload key).

APP_ID = "uk.co.maybeitssoftware.librelog"
TEAM_ID = ENV["TEAM_ID"] || "6NQNU5YSC2"
ROOT = File.expand_path("..", __dir__)

def asc_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT"], is_key_content_base64: true,
  )
end

platform :android do
  desc "Build a signed bundle and put it on the Play internal track"
  lane :internal do |opts|
    code = opts[:version_code] || raise("version_code: is required (higher than the last upload)")
    name = opts[:version_name] || "0.1.0"
    sh("cd #{ROOT} && scripts/build-android.sh")
    sh("cd #{ROOT}/android && ./gradlew -q bundleRelease -PversionCode=#{code} -PversionName=#{name}")
    upload_to_play_store(
      track: "internal",
      release_status: opts[:release_status] || "completed",
      aab: "#{ROOT}/android/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end
end

platform :ios do
  desc "Fetch (or, with readonly:false, create) the App Store signing profile"
  lane :certificates do |opts|
    match(type: "appstore", app_identifier: APP_ID, api_key: asc_key, readonly: opts[:readonly] != false)
  end

  desc "Archive the iOS app and upload it to TestFlight"
  lane :internal do |opts|
    key = asc_key
    setup_ci if ENV["CI"]
    match(type: "appstore", app_identifier: APP_ID, api_key: key, readonly: opts[:readonly] != false)
    sh("cd #{ROOT} && scripts/build-apple.sh && cd apple && xcodegen -q")
    build_number = opts[:build_number] || (latest_testflight_build_number(api_key: key, app_identifier: APP_ID, initial_build_number: 0) + 1)
    build_app(
      project: "#{ROOT}/apple/Librelog.xcodeproj", scheme: "Librelog",
      destination: "generic/platform=iOS", export_method: "app-store",
      output_directory: "#{ROOT}/apple/build", clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{TEAM_ID} " \
              "CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='match AppStore #{APP_ID}'",
      export_options: { provisioningProfiles: { APP_ID => "match AppStore #{APP_ID}" } },
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true) unless opts[:upload] == false
  end
end
