<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Nothing is backed up: the session and journal key
     must never leave the device, and the journal is synced by the app. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
