<!-- Month grid (SPEC.md §6.3): days with entries tinted by rating; select a
     day to see its entries underneath. -->
<Page
    x:Class="Dailylog.App.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Dailylog.Core"
    xmlns:pages="using:Dailylog.App.Pages"
    Background="{ThemeResource PaperBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="40,32,40,64" Spacing="20">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Calendar" Style="{StaticResource MicroLabel}" />
                    <TextBlock x:Name="MonthText" Style="{StaticResource TitleText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlainButton}" Click="OnPrevious" ToolTipService.ToolTip="Previous month">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource PlainButton}" Click="OnNext" ToolTipService.ToolTip="Next month">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel Spacing="4">
                    <Grid x:Name="WeekdayHeader" />
                    <Grid x:Name="DayGrid" RowSpacing="4" ColumnSpacing="4" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock x:Name="SelectedText" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="NothingText" Text="Nothing written this day." Style="{StaticResource BodyText}" Foreground="{ThemeResource MutedBrush}" />
                <ListView x:Name="DayList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEntryClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:EntrySummary">
                            <pages:EntryRow Entry="{x:Bind}" ShowDate="False" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Style="{StaticResource PlainButton}" Content="Write on this day" Click="OnWrite" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
