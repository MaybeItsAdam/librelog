<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Rust core's C ABI (core/src/capi.rs) and its JSON records.
       Hand-written: uniffi-bindgen-cs trails the core's uniffi-rs version. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Dailylog.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
