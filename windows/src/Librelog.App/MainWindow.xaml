<Window
    x:Class="Librelog.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LibreLog">

    <!-- The root takes the theme from Settings → Appearance. -->
    <Grid x:Name="Root" Background="{ThemeResource PaperBrush}">
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            IsSettingsVisible="True"
            IsBackButtonVisible="Auto"
            IsBackEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
            OpenPaneLength="220"
            ItemInvoked="OnItemInvoked"
            BackRequested="OnBackRequested">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Journal" Tag="journal">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Calendar" Tag="calendar">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="search">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <!-- Bottom left, above the built-in Settings item. -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="On This Day" Tag="onthisday">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Hairline between the pane and the page, not a shadow. -->
            <Border BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1,0,0,0">
                <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
            </Border>
        </NavigationView>
    </Grid>
</Window>
