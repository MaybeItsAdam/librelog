<!-- The house design language (SPEC.md §14): paper and grape, hairlines
     instead of shadows, 8px cards, 6px controls, Arvo and Geist Mono, and
     the 10px uppercase micro-label. Literal hexes live only here; every
     view uses the role brushes, which flip between light and dark. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PaperBrush" Color="#FAF8F4" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InkBrush" Color="#444054" />
            <SolidColorBrush x:Key="MutedBrush" Color="#6E6B7C" />
            <SolidColorBrush x:Key="DimBrush" Color="#B6B3BF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#E6E4EA" />
            <SolidColorBrush x:Key="HoverBrush" Color="#F1EFF1" />
            <SolidColorBrush x:Key="WellBrush" Color="#EDEBEF" />
            <!-- WinUI's own chrome, pulled onto the palette. -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FAF8F4" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FAF8F4" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FAF8F4" />
            <!-- WinUI's accent roles, as separate brushes so Settings → Appearance
                 can recolour them live (Services/AppearanceService.cs). -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#007FFF" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#007FFF" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#007FFF" />
            <!-- Google's Sign-In button, light theme (its guidelines' colours). -->
            <SolidColorBrush x:Key="GoogleButtonFillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GoogleButtonStrokeBrush" Color="#747775" />
            <SolidColorBrush x:Key="GoogleButtonTextBrush" Color="#1F1F1F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PaperBrush" Color="#1C1A23" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#25232F" />
            <SolidColorBrush x:Key="InkBrush" Color="#F5F4F7" />
            <SolidColorBrush x:Key="MutedBrush" Color="#B6B3BF" />
            <SolidColorBrush x:Key="DimBrush" Color="#6E6B7C" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#34313F" />
            <SolidColorBrush x:Key="HoverBrush" Color="#2D2B38" />
            <SolidColorBrush x:Key="WellBrush" Color="#2D2B38" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#1C1A23" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#1C1A23" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#1C1A23" />
            <!-- WinUI's accent roles, as separate brushes so Settings → Appearance
                 can recolour them live (Services/AppearanceService.cs). -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#007FFF" Opacity="0.9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#007FFF" Opacity="0.8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#007FFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#007FFF" />
            <!-- Google's Sign-In button, dark theme. -->
            <SolidColorBrush x:Key="GoogleButtonFillBrush" Color="#131314" />
            <SolidColorBrush x:Key="GoogleButtonStrokeBrush" Color="#8E918F" />
            <SolidColorBrush x:Key="GoogleButtonTextBrush" Color="#E3E3E3" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accents keep their hex in both themes. -->
    <SolidColorBrush x:Key="AzureBrush" Color="#007FFF" />
    <SolidColorBrush x:Key="EmeraldBrush" Color="#4CC38E" />
    <SolidColorBrush x:Key="RaspberryBrush" Color="#D62246" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFBF00" />
    <SolidColorBrush x:Key="AzureTintBrush" Color="#007FFF" Opacity="0.10" />
    <SolidColorBrush x:Key="AmberTintBrush" Color="#FFBF00" Opacity="0.12" />
    <SolidColorBrush x:Key="RaspberryTintBrush" Color="#D62246" Opacity="0.10" />
    <Color x:Key="SystemAccentColor">#007FFF</Color>
    <!-- The primary role: actions, links, focus, selection. Azure unless the
         user picks another accent; status colours above never change. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#007FFF" />

    <!-- Media surfaces are theme-invariant: a scrim and its text over a photo
         stay black and white, because the photo isn't ours to theme. -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#000000" Opacity="0.45" />
    <SolidColorBrush x:Key="OnScrimBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LetterboxBrush" Color="#000000" />

    <FontFamily x:Key="Serif">ms-appx:///Assets/Fonts/Arvo-Regular.ttf#Arvo</FontFamily>
    <FontFamily x:Key="SerifBold">ms-appx:///Assets/Fonts/Arvo-Bold.ttf#Arvo</FontFamily>
    <FontFamily x:Key="Mono">ms-appx:///Assets/Fonts/GeistMono.ttf#Geist Mono</FontFamily>

    <!-- One radius scale: 8px panels, 6px controls. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- WinUI's TextBlock has no uppercase transform, so micro-label text is
         uppercased where it's set: literally in XAML, Format.Caps in code. -->
    <Style x:Key="MicroLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifBold}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <!-- A day's name at the head of its group: "Today", "Tuesday". -->
    <Style x:Key="DayTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifBold}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifBold}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Serif}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    </Style>

    <!-- A raised card: half a step of tone plus a hairline, never a shadow. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- A squarish 6px tag, never a pill. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WellBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- A photo on a day: a 6px tile with a hairline, the photo filling it. -->
    <Style x:Key="PhotoTileButton" TargetType="Button">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="112" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="Background" Value="{ThemeResource WellBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- A micro-label sitting on a scrim over a photo: white whatever the theme. -->
    <Style x:Key="ScrimLabel" TargetType="TextBlock" BasedOn="{StaticResource MicroLabel}">
        <Setter Property="Foreground" Value="{StaticResource OnScrimBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <!-- Secondary actions in a day's sections ("Add event", "Add photo"):
         no box, muted, so the day's content carries the weight. -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- One row in a day's section (an event, the locked note): the whole
         row is the target, at least 44px tall, with no box of its own. -->
    <Style x:Key="DayRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <!-- The editor's metadata line under the title: a micro-label that opens
         the details. Flat, flush left, no box. -->
    <Style x:Key="MetaButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- A destructive button in a dialog: raspberry text, the usual 6px box. -->
    <Style x:Key="DangerDialogButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource RaspberryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- "Continue with Google", drawn to Google's Sign-In branding guidelines:
         the standard-colour G at 20px, 12px in from the edge with 10px before
         the label, the system font at 14px medium (Roboto isn't bundled), and
         Google's light or dark colours following the theme, on a 40px button.
         The transparent root makes the hit target 44px without growing the
         painted button. -->
    <Style x:Key="GoogleSignInButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource GoogleButtonFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GoogleButtonStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource GoogleButtonTextBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent" MinHeight="44">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateLayer.Opacity" Value="0.08" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateLayer.Opacity" Value="0.12" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.38" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Surface" Height="40" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <Border x:Name="StateLayer" Background="{TemplateBinding Foreground}" Opacity="0"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="12,0"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                    <Image Width="20" Height="20" VerticalAlignment="Center">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/GoogleG.svg" />
                                        </Image.Source>
                                    </Image>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      FontSize="{TemplateBinding FontSize}"
                                                      FontWeight="{TemplateBinding FontWeight}"
                                                      VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
