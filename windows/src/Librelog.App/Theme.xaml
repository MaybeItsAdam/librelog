<!-- The house design language (SPEC.md §14): paper and grape, hairlines
     instead of shadows, 8px cards, 6px controls, Arvo and Geist Mono, and
     the 10px uppercase micro-label. Literal hexes live only here; every
     view uses the role brushes, which flip between light and dark. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PaperBrush" Color="#FAF8F4" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InkBrush" Color="#444054" />
            <SolidColorBrush x:Key="MutedBrush" Color="#6E6B7C" />
            <SolidColorBrush x:Key="DimBrush" Color="#B6B3BF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#E6E4EA" />
            <SolidColorBrush x:Key="HoverBrush" Color="#F1EFF1" />
            <SolidColorBrush x:Key="WellBrush" Color="#EDEBEF" />
            <!-- WinUI's own chrome, pulled onto the palette. -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FAF8F4" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FAF8F4" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FAF8F4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PaperBrush" Color="#1C1A23" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#25232F" />
            <SolidColorBrush x:Key="InkBrush" Color="#F5F4F7" />
            <SolidColorBrush x:Key="MutedBrush" Color="#B6B3BF" />
            <SolidColorBrush x:Key="DimBrush" Color="#6E6B7C" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#34313F" />
            <SolidColorBrush x:Key="HoverBrush" Color="#2D2B38" />
            <SolidColorBrush x:Key="WellBrush" Color="#2D2B38" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#1C1A23" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#1C1A23" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#1C1A23" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accents keep their hex in both themes. -->
    <SolidColorBrush x:Key="AzureBrush" Color="#007FFF" />
    <SolidColorBrush x:Key="EmeraldBrush" Color="#4CC38E" />
    <SolidColorBrush x:Key="RaspberryBrush" Color="#D62246" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFBF00" />
    <SolidColorBrush x:Key="AzureTintBrush" Color="#007FFF" Opacity="0.10" />
    <SolidColorBrush x:Key="AmberTintBrush" Color="#FFBF00" Opacity="0.12" />
    <SolidColorBrush x:Key="RaspberryTintBrush" Color="#D62246" Opacity="0.10" />
    <Color x:Key="SystemAccentColor">#007FFF</Color>

    <FontFamily x:Key="Serif">ms-appx:///Assets/Fonts/Arvo-Regular.ttf#Arvo</FontFamily>
    <FontFamily x:Key="SerifBold">ms-appx:///Assets/Fonts/Arvo-Bold.ttf#Arvo</FontFamily>
    <FontFamily x:Key="Mono">ms-appx:///Assets/Fonts/GeistMono.ttf#Geist Mono</FontFamily>

    <!-- One radius scale: 8px panels, 6px controls. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- WinUI's TextBlock has no uppercase transform, so micro-label text is
         uppercased where it's set: literally in XAML, Format.Caps in code. -->
    <Style x:Key="MicroLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifBold}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="HeadlineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifBold}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Serif}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    </Style>

    <!-- A raised card: half a step of tone plus a hairline, never a shadow. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- A squarish 6px tag, never a pill. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WellBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>
</ResourceDictionary>
