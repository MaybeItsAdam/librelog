<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI 3 app (SPEC.md §2). Builds on Windows only; the logic it
       drives lives in Librelog.Shared, which is tested on any OS. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Librelog.App</RootNamespace>
    <AssemblyName>Librelog</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- Program.cs owns Main so a second launch (a sign-in link) is redirected
         to the running window. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The core, built for the matching Windows target with the capi feature. -->
    <CoreRustTarget Condition="'$(Platform)' == 'ARM64'">aarch64-pc-windows-msvc</CoreRustTarget>
    <CoreRustTarget Condition="'$(CoreRustTarget)' == ''">x86_64-pc-windows-msvc</CoreRustTarget>
    <CoreDll Condition="'$(CoreDll)' == ''">$(MSBuildThisFileDirectory)..\..\..\core\target\$(CoreRustTarget)\release\librelog_core.dll</CoreDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Librelog.Shared\Librelog.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(CoreDll)" Link="librelog_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckCoreDll" BeforeTargets="Build">
    <Error Condition="!Exists('$(CoreDll)')"
           Text="Missing $(CoreDll). Run scripts/build-windows.ps1 first." />
  </Target>
</Project>
