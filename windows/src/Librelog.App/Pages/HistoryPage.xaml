<!-- Earlier versions of an entry, including the losing side of any edit made
     on two devices at once (SPEC.md §12.5). Copy what you need back, then
     mark them reviewed. -->
<Page
    x:Class="Librelog.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Librelog.App.Pages"
    Background="{ThemeResource PaperBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="40,32,40,64" Spacing="16">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="VERSION HISTORY" Style="{StaticResource MicroLabel}" />
                    <TextBlock x:Name="HeadingText" Style="{StaticResource TitleText}" />
                </StackPanel>
                <Button x:Name="ReviewedButton" Style="{StaticResource PrimaryButton}" Content="Mark reviewed"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnReviewed" />
            </Grid>
            <TextBlock x:Name="EmptyText" Text="No earlier versions." Style="{StaticResource BodyText}" Foreground="{ThemeResource MutedBrush}" />
            <ItemsControl x:Name="Versions">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:VersionItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource MicroLabel}" />
                                    <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Visibility="{x:Bind ConflictVisibility}"
                                            Background="{StaticResource AmberTintBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1">
                                        <TextBlock Text="Edited at the same time" FontSize="11" Foreground="{ThemeResource InkBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Markdown}" Style="{StaticResource BodyText}" IsTextSelectionEnabled="True" />
                                <HyperlinkButton Content="Copy text" Tag="{x:Bind Markdown}" Click="OnCopy" Padding="0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
