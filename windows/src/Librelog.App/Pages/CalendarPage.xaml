<!-- Month grid (SPEC.md §6.3): days with entries tinted by rating; select a
     day to see its entries, events, photos and locked note underneath. Months slide in the way
     you're going; swipe or scroll sideways to turn them, or pick one from
     the title. -->
<Page
    x:Class="Librelog.App.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Librelog.Core"
    xmlns:pages="using:Librelog.App.Pages"
    Background="{ThemeResource PaperBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="40,32,40,64" Spacing="20">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="CALENDAR" Style="{StaticResource MicroLabel}" />
                    <!-- The title opens a month and year chooser. -->
                    <Button x:Name="MonthButton" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                            ToolTipService.ToolTip="Go to a month">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="MonthText" Style="{StaticResource TitleText}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="MonthFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnChooserOpening">
                                <StackPanel Spacing="10" Width="276">
                                    <Grid>
                                        <Button Style="{StaticResource PlainButton}" Click="OnPreviousYear" ToolTipService.ToolTip="Previous year">
                                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                        </Button>
                                        <TextBlock x:Name="ChooserYearText" FontFamily="{StaticResource Mono}" FontSize="15"
                                                   Foreground="{ThemeResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource PlainButton}" Click="OnNextYear" ToolTipService.ToolTip="Next year"
                                                HorizontalAlignment="Right">
                                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                    <Grid x:Name="MonthChoices" RowSpacing="6" ColumnSpacing="6" />
                                    <Button Style="{StaticResource PlainButton}" Content="This month" HorizontalAlignment="Stretch" Click="OnThisMonth" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlainButton}" Click="OnPrevious" ToolTipService.ToolTip="Previous month">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource PlainButton}" Click="OnNext" ToolTipService.ToolTip="Next month">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="OnNew" ToolTipService.ToolTip="New entry on the selected day">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="New entry" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Swipes and sideways scrolling land on the card; it clips the
                 grid as it slides. -->
            <Border x:Name="MonthCard" Style="{StaticResource Card}" Padding="12" ManipulationMode="System,TranslateX"
                    ManipulationCompleted="OnSwiped">
                <StackPanel Spacing="4">
                    <Grid x:Name="WeekdayHeader" />
                    <Grid x:Name="DayGrid" RowSpacing="4" ColumnSpacing="4">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Slide" />
                        </Grid.RenderTransform>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock x:Name="SelectedText" Style="{StaticResource MicroLabel}" />
                <TextBlock x:Name="NothingText" Text="Nothing written this day." Style="{StaticResource BodyText}" Foreground="{ThemeResource MutedBrush}" />
                <ListView x:Name="DayList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEntryClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pages:DayEntry">
                            <pages:EntryRow Entry="{x:Bind Entry}" Day="{x:Bind Day}" ShowDate="False" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- The selected day's own things: events, photos, locked note. -->
            <pages:DayCalendarView x:Name="DayEvents" />
            <pages:DayPhotosView x:Name="Photos" />
            <pages:DayLockedNoteView x:Name="LockedNote" />
        </StackPanel>
    </ScrollViewer>
</Page>
