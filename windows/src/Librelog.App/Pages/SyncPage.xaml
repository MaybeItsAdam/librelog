<!-- Sync setup and status (SPEC.md §12). Everything here is optional: the
     journal works fully without an account. -->
<Page
    x:Class="Librelog.App.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PaperBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="640" Padding="40,32,40,64" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="SYNC" Style="{StaticResource MicroLabel}" />
                <TextBlock Text="Your journal on every device" Style="{StaticResource TitleText}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="ProblemText" Style="{StaticResource BodyText}" Foreground="{StaticResource RaspberryBrush}" />

            <!-- Shown once, right after this device created the journal key. -->
            <Border x:Name="NewPhrasePanel" Style="{StaticResource Card}" BorderBrush="{StaticResource AmberBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="YOUR RECOVERY PHRASE" Style="{StaticResource MicroLabel}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="These 24 words are the only way back into your synced journal if you lose every device. Write them down and keep them somewhere safe. We can't reset them." />
                    <TextBlock x:Name="NewPhraseText" FontFamily="{StaticResource Mono}" FontSize="15" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" Foreground="{ThemeResource InkBrush}" LineHeight="26" />
                    <Button Style="{StaticResource PrimaryButton}" Content="I've written it down" Click="OnPhraseSaved" />
                </StackPanel>
            </Border>

            <!-- Off: sign in. -->
            <Border x:Name="SignInPanel" Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="SIGN IN" Style="{StaticResource MicroLabel}" />
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{ThemeResource MutedBrush}"
                               Text="Entries are encrypted on this PC before they're uploaded. The server only ever stores ciphertext." />
                    <TextBox x:Name="EmailBox" PlaceholderText="you@example.com" InputScope="EmailSmtpAddress" CornerRadius="6" />
                    <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Email me a sign-in link" Click="OnSendEmail" />
                    <StackPanel x:Name="CodePanel" Spacing="8">
                        <TextBlock x:Name="SentText" Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="CodeBox" PlaceholderText="6-digit code" Width="160" FontFamily="{StaticResource Mono}"
                                     InputScope="Number" MaxLength="8" CornerRadius="6" />
                            <Button Style="{StaticResource PlainButton}" Content="Verify" Click="OnVerify" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- NeedsKey: unlock with the phrase or by pairing. -->
            <Border x:Name="KeyPanel" Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="UNLOCK YOUR JOURNAL" Style="{StaticResource MicroLabel}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="This account already has a journal key. Bring it to this PC from a device that's syncing, or type your recovery phrase." />
                    <Button x:Name="PairButton" Style="{StaticResource PrimaryButton}" Content="Pair with another device" Click="OnPair" />
                    <StackPanel x:Name="PairingPanel" Spacing="10">
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="On a device that's already syncing, open Sync → Add a device, then scan this code or paste the text below." />
                        <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Left"
                                BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1">
                            <Image x:Name="QrImage" Width="220" Height="220" />
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PairingCodeBox" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12" CornerRadius="6" />
                            <Button Grid.Column="1" Style="{StaticResource PlainButton}" Content="Copy" Click="OnCopyPairingCode" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock Text="Waiting for your other device…" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource PlainButton}" Content="Cancel" Click="OnCancelPairing" />
                    </StackPanel>
                    <TextBlock Text="OR USE YOUR RECOVERY PHRASE" Style="{StaticResource MicroLabel}" Margin="0,8,0,0" />
                    <TextBox x:Name="PhraseBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             FontFamily="{StaticResource Mono}" PlaceholderText="24 words" CornerRadius="6" />
                    <Button Style="{StaticResource PlainButton}" Content="Unlock" Click="OnUsePhrase" />
                    <HyperlinkButton Content="Sign out" Click="OnSignOut" Padding="0" />
                </StackPanel>
            </Border>

            <!-- On: status and devices. -->
            <StackPanel x:Name="OnPanel" Spacing="20">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="STATUS" Style="{StaticResource MicroLabel}" />
                        <TextBlock x:Name="EmailText" Style="{StaticResource HeadlineText}" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource MonoText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource PrimaryButton}" Content="Sync now" Click="OnSyncNow" />
                            <Button Style="{StaticResource PlainButton}" Content="Show recovery phrase" Click="OnShowPhrase" />
                        </StackPanel>
                        <TextBlock x:Name="PhraseText" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource InkBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ADD A DEVICE" Style="{StaticResource MicroLabel}" />
                        <TextBlock Style="{StaticResource BodyText}" Foreground="{ThemeResource MutedBrush}"
                                   Text="On the new device, choose Pair with another device. Paste the code it shows here." />
                        <TextBox x:Name="ApproveBox" PlaceholderText="librelog-pair:1:…" FontFamily="{StaticResource Mono}" FontSize="12" CornerRadius="6" />
                        <Button Style="{StaticResource PlainButton}" Content="Send the key" Click="OnApprove" />
                        <TextBlock x:Name="ApproveText" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PlainButton}" Content="Sign out" Click="OnSignOut" Foreground="{StaticResource RaspberryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
