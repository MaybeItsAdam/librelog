<!-- The start screen: every entry, newest first, grouped by day, with today
     always at the top. Replaces the separate Today and Timeline pages. -->
<Page
    x:Class="Librelog.App.Pages.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Librelog.Core"
    xmlns:pages="using:Librelog.App.Pages"
    Background="{ThemeResource PaperBrush}">

    <Page.Resources>
        <pages:JournalTemplateSelector x:Key="JournalTemplates">
            <pages:JournalTemplateSelector.DayTemplate>
                <DataTemplate x:DataType="pages:JournalDay">
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource MicroLabel}" Margin="0,20,0,4" />
                </DataTemplate>
            </pages:JournalTemplateSelector.DayTemplate>
            <pages:JournalTemplateSelector.EntryTemplate>
                <DataTemplate x:DataType="core:EntrySummary">
                    <pages:EntryRow Entry="{x:Bind}" ShowDate="False" />
                </DataTemplate>
            </pages:JournalTemplateSelector.EntryTemplate>
            <pages:JournalTemplateSelector.MemoryTemplate>
                <DataTemplate x:DataType="pages:JournalMemory">
                    <pages:EntryRow Entry="{x:Bind Entry}" ShowDate="True" />
                </DataTemplate>
            </pages:JournalTemplateSelector.MemoryTemplate>
            <pages:JournalTemplateSelector.ActionTemplate>
                <DataTemplate x:DataType="pages:JournalAction">
                    <Grid Padding="0,12" ColumnSpacing="10" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="Chevron" Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource BodyText}"
                                   Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </pages:JournalTemplateSelector.ActionTemplate>
        </pages:JournalTemplateSelector>
    </Page.Resources>

    <Grid MaxWidth="760" Padding="40,32,40,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Journal" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            <Button x:Name="NewButton" Style="{StaticResource PrimaryButton}" Click="OnNew" ToolTipService.ToolTip="New entry (Ctrl+N)"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="New entry" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="List" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnItemClick" Padding="0,0,0,48" ContainerContentChanging="OnContainerChanging"
                  ItemTemplateSelector="{StaticResource JournalTemplates}">
            <!-- Rows arrive one after another on first load; opening "On this
                 day" slides the rows below down to make room. -->
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24" />
                    <AddDeleteThemeTransition />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
        </ListView>
    </Grid>
</Page>
