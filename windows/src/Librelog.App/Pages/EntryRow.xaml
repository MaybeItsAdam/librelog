<!-- One entry in Journal, Search and Calendar. -->
<UserControl
    x:Class="Librelog.App.Pages.EntryRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="0,12" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="2">
            <TextBlock x:Name="DateText" Style="{StaticResource MicroLabel}" />
            <TextBlock x:Name="TimeText" Style="{StaticResource MonoText}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="TitleText" Style="{StaticResource HeadlineText}" FontSize="16" />
                <TextBlock x:Name="FavoriteText" Text="♥" Foreground="{StaticResource RaspberryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ExcerptText" Style="{StaticResource BodyText}" MaxLines="2" TextTrimming="WordEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="RatingText" Foreground="{StaticResource AmberBrush}" FontSize="12" />
                <ItemsControl x:Name="TagList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{StaticResource Chip}" Padding="6,1">
                                <TextBlock Text="{x:Bind}" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
