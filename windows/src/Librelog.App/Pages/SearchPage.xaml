<!-- Full-text search with operators (SPEC.md §6.11), updating as you type. -->
<Page
    x:Class="Librelog.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Librelog.Core"
    xmlns:pages="using:Librelog.App.Pages"
    Background="{ThemeResource PaperBrush}">

    <Grid MaxWidth="760" Padding="40,32,40,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="SEARCH" Style="{StaticResource MicroLabel}" />
            <TextBlock Text="Find anything" Style="{StaticResource TitleText}" />
        </StackPanel>

        <TextBox x:Name="QueryBox" Grid.Row="1" PlaceholderText="Words, tag:run, rating:&gt;=4, before:2026-01-01…"
                 FontFamily="{StaticResource Serif}" FontSize="16" CornerRadius="6" TextChanged="OnQueryChanged" />

        <Grid Grid.Row="2">
            <StackPanel x:Name="ExamplesPanel" Spacing="8">
                <TextBlock Text="TRY" Style="{StaticResource MicroLabel}" />
                <ItemsControl x:Name="Examples">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:SearchExample">
                            <Grid Padding="0,8" ColumnSpacing="16" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton Content="{x:Bind Query}" Tag="{x:Bind Query}" Click="OnExample" Padding="0"
                                                 FontFamily="{StaticResource Mono}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Meaning}" Style="{StaticResource BodyText}"
                                           Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ListView x:Name="Results" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnHitClick" Padding="0,0,0,48">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:SearchHit">
                        <pages:EntryRow Entry="{x:Bind Entry}" Snippet="{x:Bind Snippet}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="NoResults" Text="No entries match." Style="{StaticResource BodyText}"
                               Foreground="{ThemeResource MutedBrush}" Margin="0,16" />
                </ListView.Footer>
            </ListView>
        </Grid>
    </Grid>
</Page>
