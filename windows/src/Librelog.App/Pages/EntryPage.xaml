<!-- Writing one entry (SPEC.md §6.2). Autosaves a moment after typing stops
     and when leaving; there's no Save button. -->
<Page
    x:Class="Librelog.App.Pages.EntryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Librelog.Core"
    xmlns:editor="using:Librelog.App.Editor"
    Background="{ThemeResource PaperBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Format bar: hairline below, no shadow. -->
        <Border BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1" Background="{ThemeResource PaperBrush}">
            <Grid MaxWidth="760" Padding="40,10">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="BoldButton" Click="OnBold" ToolTipService.ToolTip="Bold (Ctrl+B)" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="B" FontWeight="Bold" />
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicButton" Click="OnItalic" ToolTipService.ToolTip="Italic (Ctrl+I)" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="I" FontStyle="Italic" />
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineButton" Click="OnUnderline" ToolTipService.ToolTip="Underline (Ctrl+U)" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                    <ToggleButton x:Name="HighlightButton" Click="OnHighlight" ToolTipService.ToolTip="Highlight" CornerRadius="6" Padding="10,6">
                        <FontIcon Glyph="&#xE7E6;" FontSize="14" />
                    </ToggleButton>
                    <Border Width="1" Margin="6,4" Background="{ThemeResource HairlineBrush}" />
                    <ToggleButton x:Name="HeadingButton" Click="OnHeading" ToolTipService.ToolTip="Heading" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="H" FontWeight="Bold" />
                    </ToggleButton>
                    <ToggleButton x:Name="BulletButton" Click="OnBullet" ToolTipService.ToolTip="Bulleted list" CornerRadius="6" Padding="10,6">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="NumberedButton" Click="OnNumbered" ToolTipService.ToolTip="Numbered list" CornerRadius="6" Padding="10,6">
                        <FontIcon Glyph="&#xF0E1;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="CheckButton" Click="OnCheck" ToolTipService.ToolTip="Checklist" CornerRadius="6" Padding="10,6">
                        <FontIcon Glyph="&#xE73A;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="QuoteButton" Click="OnQuote" ToolTipService.ToolTip="Quote" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="“" FontSize="18" Margin="0,-4,0,-8" />
                    </ToggleButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <ToggleButton x:Name="FavoriteButton" Click="OnFavorite" ToolTipService.ToolTip="Favourite" CornerRadius="6" Padding="10,6">
                        <FontIcon Glyph="&#xEB51;" FontSize="14" />
                    </ToggleButton>
                    <Button CornerRadius="6" Padding="10,6" ToolTipService.ToolTip="More">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Copy as Markdown" Click="OnCopyMarkdown" />
                                <MenuFlyoutItem Text="Version history" Click="OnHistory" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete entry" Click="OnDelete" Foreground="{StaticResource RaspberryBrush}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="760" Padding="40,24,40,24" Spacing="16">
                <!-- Edited on two devices at once (SPEC.md §12.5). -->
                <Border x:Name="ConflictBanner" Background="{StaticResource AmberTintBrush}" BorderBrush="{StaticResource AmberBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Text="This entry was edited on two devices at once. The other version is kept in its history." />
                        <Button Grid.Column="1" Style="{StaticResource PlainButton}" Content="Review" Click="OnHistory" />
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="RangeText" Style="{StaticResource MicroLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CalendarDatePicker x:Name="DatePicker" DateChanged="OnDateChanged" CornerRadius="6" />
                        <TimePicker x:Name="TimePicker" SelectedTimeChanged="OnTimeChanged" CornerRadius="6" MinuteIncrement="1" />
                    </StackPanel>
                    <!-- Multi-day entries (SPEC.md §4): a trip, a festival. -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="SeveralDaysBox" Content="Several days" Click="OnSeveralDays" MinWidth="0" />
                        <CalendarDatePicker x:Name="EndPicker" DateChanged="OnEndChanged" CornerRadius="6"
                                            PlaceholderText="Last day" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <TextBox x:Name="TitleBox" PlaceholderText="Title" FontFamily="{StaticResource SerifBold}" FontSize="26"
                         BorderThickness="0" Background="Transparent" Padding="0" TextChanged="OnTitleChanged" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RatingControl x:Name="Rating" MaxRating="5" IsClearEnabled="True" ValueChanged="OnRatingChanged" />
                    <ItemsControl x:Name="TagList" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:Tag">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                                        <Button Tag="{x:Bind Id}" Click="OnRemoveTag" Padding="2" MinWidth="0" MinHeight="0"
                                                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Remove tag">
                                            <FontIcon Glyph="&#xE711;" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="TagBox" PlaceholderText="Add tag" Width="140" CornerRadius="6" KeyDown="OnTagKeyDown" />
                </StackPanel>

                <editor:RichEditor x:Name="Editor" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="760" Padding="40,8">
                <TextBlock x:Name="WordCount" Style="{StaticResource MonoText}" />
                <TextBlock x:Name="SavedText" Style="{StaticResource MonoText}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Page>
